# Preserve benchmark originals, including upstream CRLF and bundled shader whitespace.
examples/benchmarks/*/*.html -text -whitespace linguist-generated=true
examples/benchmarks/*/prompt.txt -text -whitespace
examples/benchmarks/voxel-mountain-max/assets/* -text -whitespace linguist-generated=true
examples/benchmarks/*/fonts/OFL-*.txt -text -whitespace
examples/benchmarks/*-sol-max/assets/* -text -whitespace linguist-generated=true
examples/benchmarks/*-astra-max/assets/* -text -whitespace linguist-generated=true

# Keep upstream JSDoc/CSS string spaces and unified-patch blank context reproducible.
src/client/vendor/page-flip.js whitespace=-blank-at-eol
src/client/vendor/page-flip.patch whitespace=-blank-at-eol

# Preserve the original Vite license notice blockquote spacing in this benchmark.
examples/benchmarks/cloud-mountain-city-sol-max/licenses/vite-MIT-and-notices.txt -text whitespace=-blank-at-eol

{
  "name": "personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "build:site": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",

    "@types/three": "0.186.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "8.3.0"

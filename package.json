    "@fontsource/vt323": "^5.3.0",
    "@paper-design/shaders": "0.0.80",
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/preset-matrix": "4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "7z-wasm": "1.2.0",
    "astro": "^7.3.2",
    "astro-expressive-code": "^0.44.2",
    "baffle": "0.3.6",
    "cropperjs": "2.2.0",
    "cytoscape": "^3.34.3",
    "dompurify": "3.4.15",
    "fast-xml-parser": "^5.11.1",

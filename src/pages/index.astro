---
import Base from '../layouts/Base.astro';
import { config } from '../config';
import '../styles/hero.css';
import { content } from '../application/content';
const { articles } = await content();
const headlines = articles.slice(0, 5).map((article) => article.data.title);
const code = `const notebook = {\n  author: ${JSON.stringify(config.name)},\n  focus: 'CODE · LIFE · JOURNEY'\n};\n\nfunction stay() {\n  return '留一点空白。';\n}`;
const github = import.meta.env.PUBLIC_GITHUB_URL || config.githubUrl;
const githubSource = import.meta.env.PUBLIC_GITHUB_SOURCE_URL || config.githubSourceUrl;
---

<Base family="hero">
  <section
    class:list={['hero', { 'has-hero-source': Boolean(githubSource) }]}
    id="hero"
    data-effect="io724"
    data-headlines={JSON.stringify(headlines)}
  >
    <div id="hero-stage" aria-hidden="true"></div>
    <header class="hero-top">
      <span>{config.name}</span>
      <div class="hero-top-links">
        <span class="hero-tagline">留一点空白。</span>
        {github && (
          <a
            class="hero-github"
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="访问我的 GitHub（新窗口）"
          >
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
            GitHub ↗
          </a>
        )}
      </div>
    </header>
    <div class="hero-copy">
      <p class="eyebrow">A PERSONAL SPACE</p>
      <h1>{config.name}</h1>
      <p class="hero-description">{config.description}</p>
      <p class="saying">{config.sayings[0]}</p>
    </div>
    <div class="hero-index">
      <article class="index-card" data-front="true">
        <span>01 / NOTEBOOK</span>
        <h2>
          写作
          <br />间
        </h2>
        <p>{config.about}</p>
        <a href="/articles/">阅读文章 ↗</a>
      </article>
      <article class="index-card" data-front="false" inert>
        <span>02 / PLAYGROUND</span>
        <h2>
          实验
          <br />室
        </h2>
        <p>一些想法，一些实现。保留探索的余地。</p>
        <a href="/lab/">浏览实验 ↗</a>
      </article>
      <button id="index-switch" aria-label="切换索引卡片">
        切换 ↔
      </button>
    </div>
    <div class="hero-code-window" aria-hidden="true">
      <div class="code-window-bar">
        <i></i>
        <i></i>
        <i></i>
        <span>notebook.ts</span>
      </div>
      <pre><code id="hero-code" data-text={code}>{code}</code></pre>
    </div>
    <div class="hero-bottom">
      <a class="enter" href="/articles/">
        <span>↗</span>进入文章
      </a>
    </div>

    <div id="effect-picker" role="group" aria-label="切换首屏效果">
      <button id="effect-prev" type="button" aria-label="上一个首屏效果" title="上一个首屏效果">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="m14 6-6 6 6 6" />
        </svg>
      </button>
      <div class="effect-current" aria-live="polite" aria-atomic="true">
        <span class="effect-caption">
          首屏效果 <span id="effect-position">1 / {config.hero.length}</span>
        </span>
        <span id="effect-label">流体墨迹</span>
      </div>
      <button id="effect-next" type="button" aria-label="下一个首屏效果" title="下一个首屏效果">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="m10 6 6 6-6 6" />
        </svg>
      </button>
    </div>

    {githubSource && (
      <p class="hero-source-note">
        首屏实现已开源，
        <a
          href={githubSource}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="在 GitHub 获取首屏实现（新窗口）"
        >
          去 GitHub 自取 ↗
        </a>
      </p>
    )}
  </section>
</Base>
